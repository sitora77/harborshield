name: Tests
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  model-and-dashboard:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: pip
      - run: python -m pip install -r requirements-research.txt
      - run: python -m unittest discover -s tests -v
      - run: python scripts/run_experiments.py --output-dir /tmp/harborshield-evidence
      - run: python scripts/run_case_study.py
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - run: node scripts/test_case_calculator.cjs
